<!DOCTYPE html>
<html lang="fr">
<%- include('layouts/header'); -%>
<body>
  <%- include('layouts/navbar'); -%>

  <!-- Page Header -->
  <header class="masthead">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
          <div class="post-heading">
            <h1><%= blogposts.title %></h1>
            <h2 class="subheading"><%- blogposts.body %></h2>
            <span class="meta">Posted by
              <a href="#"><%= blogposts.userid ? blogposts.userid.username : 'Anonyme' %></a>
              on <%= blogposts.datePosted.toLocaleDateString('fr-FR') %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Post Content -->
  <article>
    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
          <%- blogposts.body %>
          <img src="<%= blogposts.image %>" class="img-fluid" alt="image article blog" />
        </div>
      </div>
    </div>
  </article>

  <hr>
  <%- include('layouts/footer'); -%>
  <%- include('layouts/scripts'); -%>
</body>
</html>
